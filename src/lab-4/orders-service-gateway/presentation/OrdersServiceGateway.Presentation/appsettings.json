{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Grpc:Processing": {
    "Host": "localhost",
    "Port": 8080
  },
  "Grpc:Creation": {
    "Host": "localhost",
    "Port": 8020
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "gRPC": {
        "Url": "http://*:8030",
        "Protocols": "Http2"
      },
      "Http": {
        "Url": "http://*:8032",
        "Protocols": "Http1"
      }
    }
  },
  "Kafka": {
    "Producer": {
      "BootstrapServers": "localhost:8001",
      "Topic": "order_creation",
      "Acks": "All",
      "BatchSize": 1024
    },
    "Consumer": {
      "GroupId": "order-creation-consumer",
      "BootstrapServers": "localhost:8001 ",
      "Topic": "order_processing",
      "BatchSize": 1024
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Database=lab-3-test-postgres-db;Username=postgres;Password=postgres;Port=5433"
  }
}